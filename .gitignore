/target/
**/*.rs.bk
.env
*.local
# Vrais PDF de l'utilisateur (PV, scans) : jamais dans le dépôt public
/essais-prives/
# Modèles OCR téléchargés par scripts/modeles-ocr.sh (jamais dans le dépôt)
/modeles/
# Dossier de travail du script de paquet
/paquet/
/Massicot.*.zip
/Massicot.*.exe
# Version précédente téléchargée par la CI pour l'essai de mise à jour
/precedente/
# Images written by the screen tests when they differ from the reference
/crates/massicot/tests/snapshots/*.new.png
/crates/massicot/tests/snapshots/*.diff.png
/crates/massicot/tests/snapshots/*.old.png
